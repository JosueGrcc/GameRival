# Plantilla del archivo .env. Este archivo SI se sube a GitHub, por eso no lleva datos reales.
# En cada computadora: copia este archivo, nombralo ".env" y llena los valores.

# Llave secreta de Django (cualquier texto largo y aleatorio)
SECRET_KEY=pon-aqui-una-llave-secreta
DEBUG=True

# Conexion a MySQL
DB_NAME=gamerival
DB_USER=root
DB_PASSWORD=tu-contrasena-de-mysql
DB_HOST=127.0.0.1
DB_PORT=3306

# Llaves de las APIs
# Steam: https://steamcommunity.com/dev/apikey
STEAM_API_KEY=pon-aqui-tu-llave-de-steam
# Riot: https://developer.riotgames.com (caduca cada 24 horas)
RIOT_API_KEY=pon-aqui-tu-llave-de-riot

# Correo para "¿Olvidaste tu contraseña?" (opcional).
# Si lo dejas comentado, el correo se imprime en la terminal de runserver en vez de enviarse.
# Con Gmail: activa la verificación en 2 pasos y crea una "contraseña de aplicación"
# en https://myaccount.google.com/apppasswords (NO uses tu contraseña normal).
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=tucorreo@gmail.com
# EMAIL_HOST_PASSWORD=la-contrasena-de-aplicacion
