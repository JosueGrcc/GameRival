# Plantilla del archivo .env. Este archivo SI se sube a GitHub, por eso no lleva datos reales.
# En cada computadora: copia este archivo, nombralo ".env" y llena los valores.

# Llave secreta de Django (cualquier texto largo y aleatorio)
SECRET_KEY=pon-aqui-una-llave-secreta
DEBUG=True

# Conexion a MySQL
DB_NAME=gamerival
DB_USER=root
DB_PASSWORD=tu-contrasena-de-mysql
DB_HOST=127.0.0.1
DB_PORT=3306

# Llaves de las APIs
# Steam: https://steamcommunity.com/dev/apikey
STEAM_API_KEY=pon-aqui-tu-llave-de-steam
# Riot: https://developer.riotgames.com (caduca cada 24 horas)
RIOT_API_KEY=pon-aqui-tu-llave-de-riot
